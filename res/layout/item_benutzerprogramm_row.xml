<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:background="?android:attr/selectableItemBackground">

    <TextView
        android:id="@+id/row_nr"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:text="1" />

    <Button
        android:id="@+id/row_datum"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:layout_marginEnd="4dp"
        android:textSize="16sp"
        android:text="TT.MM.JJJJ"
        android:minWidth="80dp" />

    <Button
        android:id="@+id/row_zeit"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="0.8"
        android:layout_marginEnd="2dp"
        android:textSize="16sp"
        android:text="--:--"
        android:minWidth="60dp" />
    <Button
        android:id="@+id/row_ganzer_tag"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:minHeight="40dp"
        android:text="Ganzer Tag"
        android:textSize="12sp"
        android:layout_marginEnd="4dp" />

    <Spinner
        android:id="@+id/row_melodie"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1.8"
        android:layout_marginEnd="4dp"
        android:minWidth="80dp"
        android:spinnerMode="dropdown" />

    <Spinner
        android:id="@+id/row_tagtyp"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1.2"
        android:layout_marginEnd="4dp"
        android:minWidth="100dp"
        android:spinnerMode="dropdown" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/row_loeschen"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minHeight="40dp"
            android:text="Löschen"
            android:textSize="14sp"
            android:layout_marginEnd="2dp" />

        <Button
            android:id="@+id/row_kopieren"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minHeight="40dp"
            android:text="Kopieren"
            android:textSize="14sp"
            android:layout_marginEnd="2dp" />

        <Button
            android:id="@+id/row_einfuegen"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minHeight="40dp"
            android:text="Einfügen"
            android:textSize="14sp"
            android:layout_marginEnd="2dp" />

        <Button
            android:id="@+id/row_speichern"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minHeight="40dp"
            android:text="Speichern"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
